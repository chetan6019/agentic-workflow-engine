FROM workflow-base:latest

WORKDIR /app

COPY app ./app
COPY scripts ./scripts
# Alembic config + migration scripts: init_db runs `alembic upgrade head` on
# startup, so the api image (and the seed script it hosts) needs these present.
COPY alembic.ini ./alembic.ini
COPY alembic ./alembic

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
