# React web UI: build the Vite bundle with Node, serve the static files with
# nginx. Unlike the Python images this does NOT derive from workflow-base.
# nginx also proxies /v1 to the api service (see web/nginx.conf), so the SPA
# is same-origin with the API in production.

FROM node:22-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY web/ ./
RUN npm run build

FROM nginx:alpine
COPY web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
