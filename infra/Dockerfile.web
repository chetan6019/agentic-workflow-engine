# React web UI: build the Vite bundle with Node, serve the static files with
# nginx. Unlike the Python images this does NOT derive from workflow-base.
# nginx also proxies /v1 to the api service (see web/nginx.conf), so the SPA
# is same-origin with the API in production.

FROM node:22-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY web/ ./
RUN npm run build

FROM nginx:alpine
# Upgrade OS packages to the latest patched versions in Alpine's repos: the floating
# nginx:alpine tag often lags fixed CVEs (e.g. c-ares/libexpat HIGHs, 2026-07), which
# fails CI's Trivy gate until upstream rebuilds. This keeps the scan green without
# pinning digests by hand.
RUN apk upgrade --no-cache
COPY web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
