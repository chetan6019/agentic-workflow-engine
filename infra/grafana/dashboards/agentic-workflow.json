{
  "id": null,
  "uid": "agentic-workflow",
  "title": "Agentic Workflow Engine — RED + Cost",
  "tags": ["agentic-workflow", "red", "llm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Run latency (p50 / p95 / p99)",
      "description": "End-to-end workflow run latency. Source: workflow_run_latency_seconds.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(workflow_run_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(workflow_run_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(workflow_run_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Run throughput by outcome",
      "description": "Runs/sec split into ok / error / timeout. Source: workflow_run_latency_seconds_count.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(workflow_run_latency_seconds_count[5m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Node latency p95 by node",
      "description": "Per-orchestration-node latency. Source: node_latency_seconds.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(node_latency_seconds_bucket[5m])) by (le, node))",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "MCP tool latency p95 by server",
      "description": "Per-MCP tool-call latency. Source: mcp_tool_latency_seconds.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(mcp_tool_latency_seconds_bucket[5m])) by (le, server))",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "MCP tool error rate by server",
      "description": "Failed tool calls/sec (ok=false). Source: mcp_tool_latency_seconds_count.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(mcp_tool_latency_seconds_count{ok=\"false\"}[5m])) by (server)",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Guardrail enforcement by rule",
      "description": "Block / flag / rate-limit actions per sec. Source: guardrail_block_total.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(guardrail_block_total[5m])) by (rule)",
          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LiteLLM spend (USD)",
      "description": "Total LLM spend reported by the LiteLLM proxy's prometheus exporter. Empty until the proxy's prometheus callback is active (see infra/litellm_config.yaml).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(litellm_spend_metric)",
          "legendFormat": "total spend"
        }
      ]
    }
  ]
}
