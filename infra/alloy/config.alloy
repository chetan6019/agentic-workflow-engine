// Grafana Alloy — ship docker container stdout (structlog JSON) to Loki.
// Pipeline: discover compose containers -> label by service -> read logs ->
// parse structlog JSON -> write to Loki.

// 1. Discover running containers via the Docker socket.
discovery.docker "compose" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

// 2. Promote docker metadata to LOW-CARDINALITY labels only.
discovery.relabel "compose" {
  targets = discovery.docker.compose.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

// 3. Tail discovered containers' stdout/stderr.
//    `refresh_interval` syncs the active target set with discovery — without it,
//    targets are read once at startup and new containers (or restarts that
//    change container IDs) are missed until Alloy is restarted.
loki.source.docker "compose" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.compose.output
  refresh_interval = "10s"
  forward_to       = [loki.process.structlog.receiver]
}

// 4. Parse the structlog JSON. Extract useful fields so `| json | <field>="..."`
//    works at query time, but promote ONLY `level` to a label.
//    `event`, `trace_id`, `user_id`, `session_id` stay in the line body —
//    high or unbounded cardinality => never a label.
loki.process "structlog" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      level      = "level",
      event      = "event",
      trace_id   = "trace_id",
      user_id    = "user_id",
      session_id = "session_id",
      timestamp  = "timestamp",
    }
  }

  stage.labels {
    values = {
      level = "",     // only low-cardinality field promoted to a label
    }
  }

  // STALE (2026-06-24): timestamp parsing was silently dropping lines when
  // structlog's format didn't match exactly. Reverted to ingestion time — fine
  // in dev. To re-enable, first run `docker compose logs api | head -1 | jq .timestamp`
  // to confirm the exact format structlog emits and match `format` to it.
  // stage.timestamp {
  //   source = "timestamp"
  //   format = "RFC3339Nano"
  //   fallback_formats = ["RFC3339"]
  // }
}

// 5. Push to Loki.
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ── OpenTelemetry pipeline ────────────────────────────────────────────────────
// The app (and the LiteLLM proxy's "otel" callback) export OTLP spans here.
// Traces are forwarded to Langfuse; latency metrics are DERIVED from the same
// spans (spanmetrics) and remote-written to Prometheus — this replaces the
// node/tool/HTTP latency histograms the app used to maintain by hand.

// 6. Receive OTLP from the compose network (app: http://alloy:4318).
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [
      otelcol.exporter.otlphttp.langfuse.input,
      otelcol.connector.spanmetrics.default.input,
    ]
  }
}

// 7. Traces → Langfuse's native OTLP endpoint.
//    LANGFUSE_OTEL_AUTH must hold "Basic <base64(public_key:secret_key)>".
//    Both env vars come from .env via the alloy service's env_file.
otelcol.exporter.otlphttp "langfuse" {
  client {
    endpoint = string.format("%s/api/public/otel", sys.env("LANGFUSE_HOST"))
    headers = {
      "Authorization" = sys.env("LANGFUSE_OTEL_AUTH"),
    }
  }
}

// 8. Derive request-rate/latency metrics from spans (RED without hand-rolled
//    histograms). Series are named per span name, e.g. duration of
//    "node.planner", "mcp.tool_call", "retrieve.search".
otelcol.connector.spanmetrics "default" {
  histogram {
    explicit {
      buckets = ["50ms", "100ms", "250ms", "500ms", "1s", "2s", "5s", "10s", "15s", "20s", "30s", "45s", "1m", "1m30s", "2m"]
    }
  }
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

// 9. Span-derived metrics → Prometheus (needs --web.enable-remote-write-receiver
//    on the prometheus service, set in docker-compose.yml).
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}